table MEASURE_TABLE
	lineageTag: 6d2c5f86-2ddd-41f1-82d8-457bbb2037f1

	measure FOLLOWERS =
			
			
			DISTINCTCOUNTNOBLANK(FOLLOWERS[USERNAME])
		formatString: #,0
		lineageTag: 6da89751-7b4b-4714-8368-9c0c7583ca60

	measure FOLLOWING =
			
			
			DISTINCTCOUNTNOBLANK(FOLLOWING[USERNAME])
		formatString: #,0
		lineageTag: 054af06d-4990-4df2-9e7b-eb7eddec8db5

	measure 'CLOSE FRIENDS' =
			
			
			CALCULATE(
			    [FOLLOWING],
			    FOLLOWING[CLOSE_FRIENDS] = "YES"
			)
		formatString: #,0
		lineageTag: 99cab33f-0c0d-48a2-9aca-e308d6b191a3

	measure 'NON FOLLOW BACK' =
			
			
			CALCULATE(
			    [FOLLOWING],
			    FOLLOWING[FOLLOW_BACK] = "NO"
			)
		formatString: #,0
		lineageTag: 7315be52-2576-4480-9faf-e1bdc59e69fc

	column MEASURE_TABLE
		dataType: string
		isHidden
		lineageTag: 6ec7aca8-f1ea-40e6-a364-3e4510cc0cd3
		summarizeBy: none
		sourceColumn: MEASURE_TABLE

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition MEASURE_TABLE = m
		mode: import
		queryGroup: OTHERS
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [MEASURE_TABLE = _t])
				in
				  Source

	annotation PBI_ResultType = Table

