		summarizeBy: none
		sourceColumn: URL

		annotation SummarizationSetBy = Automatic

	column FOLLOW_BACK = ```
			
			
			-- Check if find the person following back
			VAR __FB = 
			LOOKUPVALUE(
			    FOLLOWERS[USERNAME],
			    FOLLOWERS[USERNAME],
			    FOLLOWING[USERNAME]
			)
			
			RETURN
			
			IF(
			    ISBLANK(__FB),
			    "NO",
			    "YES"
			)
			```
		lineageTag: d92b6f56-39aa-4cc2-986a-c32bd5985012
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CLOSE_FRIENDS = ```
			
			
			VAR __CF = 
			
			RELATED(CLOSE_FRIENDS[USERNAME])
			
			RETURN
			
			IF(
			    ISBLANK(__CF),
			    "NO",
			    "YES"
			)
			```
		lineageTag: c52eabce-6b89-4d62-abe8-5773799557b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

